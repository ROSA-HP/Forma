<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!--
      Plain solid launch screen: Android shows only this black colour while the
      WebView loads, then our animated splash (logo + FORMA + line) plays on the
      same black background, then the app appears. No static logo here anymore —
      it used to flash as "logo on black" before the animation and look broken.
      A shape (not a bitmap) can never stretch on tall screens.
    -->
    <solid android:color="#0B0D10" />

</shape>
